#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0,std140) uniform Camera {
 mat4 viewProj;
 mat4 view;
 vec4 viewportNearFar;
 mat4 lightViewProj;
 vec4 cameraPosTime;
 vec4 sunDirIntensity;
 vec4 skyParams;
 vec4 gridParams;
} camera;
struct Light { vec4 positionRadius; vec4 colorIntensity; };
layout(set=1,binding=0,std430) readonly buffer Lights { Light lights[128]; } lightBuffer;
layout(set=1,binding=1,std430) buffer Clusters { uint data[]; } clusters;
layout(set=1,binding=3) uniform sampler2D depthTexture;
layout(set=1,binding=4,std430) buffer TileDepth { vec2 ranges[]; } tileDepth;
layout(push_constant) uniform RenderMode { uint mode; } renderMode;

const uint CZ=24u;
const uint MAX_LIGHTS=16u;
const uint TILE_SIZE=32u;

float depthToView(float d){
 float n=camera.viewportNearFar.z,f=camera.viewportNearFar.w;
 return (n*f)/max(f-d*(f-n),0.0001);
}

void main(){
 uint CX=max(1u,uint(camera.gridParams.x));
 uint CY=max(1u,uint(camera.gridParams.y));
 uint lightCount=min(128u,uint(camera.gridParams.z));
 if(renderMode.mode==3u){
  uint ti=gl_GlobalInvocationID.x;
  if(ti>=CX*CY)return;
  uint tx=ti%CX,ty=ti/CX;
  float mn=camera.viewportNearFar.w,mx=camera.viewportNearFar.z;
  vec2 texel=1.0/vec2(camera.viewportNearFar.xy);
  for(uint sy=0u;sy<8u;sy++)for(uint sx=0u;sx<8u;sx++){
   vec2 p=vec2(float(tx*TILE_SIZE)+float(sx*TILE_SIZE/8u)+0.5,
               float(ty*TILE_SIZE)+float(sy*TILE_SIZE/8u)+0.5)*texel;
   if(p.x>=1.0||p.y>=1.0)continue;
   float d=texture(depthTexture,p).r;
   if(d>=0.99999)continue;
   float vz=depthToView(d);
   mn=min(mn,vz);mx=max(mx,vz);
  }
  if(mn>mx){mn=camera.viewportNearFar.z;mx=camera.viewportNearFar.w;}
  tileDepth.ranges[ti]=vec2(mn,mx);
  return;
 }
 uint ci=gl_GlobalInvocationID.x,CLUSTERS=CX*CY*CZ;
 if(ci>=CLUSTERS)return;
 uint x=ci%CX,y=(ci/CX)%CY,z=ci/(CX*CY),ti=y*CX+x,count=0u;
 float nz=camera.viewportNearFar.z,fz=camera.viewportNearFar.w;
 vec2 tr=tileDepth.ranges[ti];
 float z0=nz*exp(log(fz/nz)*float(z)/float(CZ));
 float z1=nz*exp(log(fz/nz)*float(z+1u)/float(CZ));
 z0=max(z0,tr.x);z1=min(z1,tr.y);
 if(z0>z1){clusters.data[ci]=0u;return;}
 vec2 center=vec2((float(x)+0.5)/float(CX)*2.0-1.0,(float(y)+0.5)/float(CY)*2.0-1.0);
 vec2 cell=vec2(2.0/float(CX),2.0/float(CY));
 for(uint li=0u;li<lightCount;li++){
  vec3 lpv=(camera.view*vec4(lightBuffer.lights[li].positionRadius.xyz,1.0)).xyz;
  float depth=-lpv.z,radius=lightBuffer.lights[li].positionRadius.w;
  if(depth+radius<z0||depth-radius>z1||depth<=0.0)continue;
  vec4 clip=camera.viewProj*vec4(lightBuffer.lights[li].positionRadius.xyz,1.0);
  if(clip.w<=0.0)continue;
  vec2 ndc=clip.xy/clip.w;
  float screenR=radius/max(depth,.05)*1.65;
  if(abs(center.x-ndc.x)<=screenR+cell.x*.55&&abs(center.y-ndc.y)<=screenR+cell.y*.55&&count<MAX_LIGHTS){
   clusters.data[CLUSTERS+ci*MAX_LIGHTS+count]=li;
   count++;
  }
 }
 clusters.data[ci]=count;
}